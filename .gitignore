# End of https://www.gitignore.io/api/python

# The generated token artifacts ARE committed, on purpose. PRD §7.2 wants a
# token change to arrive as a reviewable CSS diff on a PR — designers never
# touch CSS, but somebody still has to see what their change did. The generic
# `dist/` and `lib/` rules above would swallow them, so they are re-included
# here. CI enforces freshness by rebuilding and asserting a clean tree, which is
# a stronger guarantee than a lint rule against hand-editing.
!packages/tokens/dist/
!packages/tokens/dist/**
!packages/tokens/src/generated/
!packages/tokens/src/generated/**
!packages/*/style/generated/
!packages/*/style/generated/**

# OSX files
.DS_Store

# Yarn cache
.yarn/

# Claude Code
.claude/
CLAUDE.md
.memsearch/
scope/*
