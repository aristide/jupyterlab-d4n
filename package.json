{
    "name": "jupyterlab-d4n",
    "version": "0.1.0",
    "private": true,
    "description": "Data4Now design-system replatform of the JupyterLab interface",
    "keywords": [
        "jupyter",
        "jupyterlab",
        "jupyterlab-extension",
        "design-system",
        "theme"
    ],
    "homepage": "https://github.com/aristide/jupyterlab-d4n",
    "bugs": {
        "url": "https://github.com/aristide/jupyterlab-d4n/issues"
    },
    "license": "BSD-3-Clause",
    "author": {
        "name": "Data4Now",
        "email": "platform@data4now.org"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/aristide/jupyterlab-d4n.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "jlpm build:tokens && jlpm build:lib && jlpm build:labextension:dev",
        "build:prod": "jlpm clean && jlpm build:tokens && jlpm build:lib:prod && jlpm build:labextension",
        "build:tokens": "yarn workspace @d4n/tokens run build",
        "build:lib": "node scripts/run-workspaces.mjs build:lib",
        "build:lib:prod": "node scripts/run-workspaces.mjs build:lib:prod",
        "build:labextension": "node scripts/run-workspaces.mjs build:labextension && node scripts/stamp-install-json.mjs",
        "build:labextension:dev": "node scripts/run-workspaces.mjs build:labextension:dev && node scripts/stamp-install-json.mjs",
        "clean": "jlpm clean:lib",
        "clean:lib": "node scripts/run-workspaces.mjs clean:lib",
        "clean:labextension": "rimraf jupyterlab_d4n/labextensions jupyterlab_d4n/_version.py",
        "clean:lintcache": "rimraf .eslintcache .stylelintcache",
        "clean:all": "jlpm clean:lib && jlpm clean:labextension && jlpm clean:lintcache",
        "eslint": "jlpm eslint:check --fix",
        "eslint:check": "eslint . --cache --ext .ts,.tsx",
        "install:extension": "jlpm build",
        "lint": "jlpm stylelint && jlpm prettier && jlpm eslint",
        "lint:check": "jlpm stylelint:check && jlpm prettier:check && jlpm eslint:check",
        "prettier": "jlpm prettier:base --write --list-different",
        "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.mjs,.css,.json,.md}\"",
        "prettier:check": "jlpm prettier:base --check",
        "stylelint": "jlpm stylelint:check --fix",
        "stylelint:check": "stylelint --cache \"packages/*/style/**/*.css\"",
        "watch": "run-p watch:tokens watch:src watch:labextension",
        "watch:tokens": "yarn workspace @d4n/tokens run watch",
        "watch:src": "tsc -b --watch --preserveWatchOutput",
        "watch:labextension": "node scripts/run-workspaces.mjs --parallel watch:labextension",
        "lint:tokens": "node tests/lint/lint-literals.mjs",
        "lint:menus": "node tests/lint/lint-menu-active.mjs",
        "lint:icons": "node tests/lint/lint-icon-colors.mjs",
        "lint:anchors": "node tests/lint/lint-doc-anchors.mjs",
        "lint:important": "node tests/lint/lint-important.mjs",
        "lint:vars": "node tests/lint/lint-var-names.mjs",
        "lint:design": "run-s lint:vars lint:tokens lint:menus lint:icons lint:anchors lint:important",
        "test:contrast": "node tests/contrast/audit.mjs",
        "test:contrast:report": "node tests/contrast/audit.mjs --report",
        "test:selectors": "node tests/galata/selector-integrity.mjs",
        "test:extract-vars": "node tests/galata/extract-jp-variables.mjs",
        "test:galata": "playwright test --config tests/galata/playwright.config.js",
        "test:galata:update": "playwright test --config tests/galata/playwright.config.js --update-snapshots",
        "test:menu-icons": "node tests/galata/menu-icon-census.mjs",
        "tasks": "node scripts/run-tasks.mjs",
        "tasks:run": "node scripts/run-tasks.mjs --yes",
        "tasks:follow": "node scripts/run-tasks.mjs --follow",
        "tasks:status": "node scripts/run-tasks.mjs --status",
        "tasks:report": "node scripts/run-tasks.mjs --report"
    },
    "devDependencies": {
        "@jupyterlab/builder": "^4.5.0",
        "@jupyterlab/galata": "^5.5.0",
        "@playwright/test": "^1.48.0",
        "@types/json-schema": "^7.0.11",
        "@types/react": "^18.0.26",
        "@typescript-eslint/eslint-plugin": "^6.1.0",
        "@typescript-eslint/parser": "^6.1.0",
        "css-loader": "^6.7.1",
        "eslint": "^8.36.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-prettier": "^5.0.0",
        "mkdirp": "^1.0.3",
        "npm-run-all2": "^7.0.1",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.1",
        "source-map-loader": "^1.0.2",
        "style-loader": "^3.3.1",
        "stylelint": "^15.10.1",
        "stylelint-config-recommended": "^13.0.0",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-csstree-validator": "^3.0.0",
        "stylelint-prettier": "^4.0.0",
        "typescript": "~5.5.4",
        "yaml": "^2.5.0",
        "yjs": "^13.5.0"
    },
    "resolutions": {
        "lib0": "0.2.111"
    },
    "eslintIgnore": [
        "node_modules",
        "dist",
        "coverage",
        "design-reference",
        "**/lib/**",
        "**/*.d.ts",
        "packages/tokens/dist",
        "packages/*/src/generated/**"
    ],
    "eslintConfig": {
        "extends": [
            "eslint:recommended",
            "plugin:@typescript-eslint/eslint-recommended",
            "plugin:@typescript-eslint/recommended",
            "plugin:prettier/recommended"
        ],
        "parser": "@typescript-eslint/parser",
        "parserOptions": {
            "//": "A GLOB over the workspace configs, not the root tsconfig.json. The root is solution-style — `files: []` plus `references` — so it includes no source at all, and typescript-eslint reports every file as 'not included in the project'. Each package's own tsconfig is what actually covers its src/. tests/tsconfig.json covers tests/**/*.ts, which no package config includes.",
            "project": [
                "packages/*/tsconfig.json",
                "tests/tsconfig.json"
            ],
            "sourceType": "module"
        },
        "plugins": [
            "@typescript-eslint"
        ],
        "rules": {
            "@typescript-eslint/naming-convention": [
                "error",
                {
                    "selector": "interface",
                    "format": [
                        "PascalCase"
                    ],
                    "custom": {
                        "regex": "^I[A-Z]",
                        "match": true
                    }
                }
            ],
            "@typescript-eslint/no-unused-vars": [
                "warn",
                {
                    "args": "none"
                }
            ],
            "@typescript-eslint/no-explicit-any": "off",
            "@typescript-eslint/no-namespace": "off",
            "@typescript-eslint/no-use-before-define": "off",
            "@typescript-eslint/quotes": [
                "error",
                "single",
                {
                    "avoidEscape": true,
                    "allowTemplateLiterals": false
                }
            ],
            "curly": [
                "error",
                "all"
            ],
            "eqeqeq": "error",
            "prefer-arrow-callback": "error"
        }
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "auto",
        "overrides": [
            {
                "files": "package.json",
                "options": {
                    "tabWidth": 4
                }
            }
        ]
    },
    "stylelint": {
        "extends": [
            "stylelint-config-recommended",
            "stylelint-config-standard",
            "stylelint-prettier/recommended"
        ],
        "plugins": [
            "stylelint-csstree-validator"
        ],
        "rules": {
            "csstree/validator": true,
            "property-no-vendor-prefix": null,
            "selector-class-pattern": null,
            "selector-no-vendor-prefix": null,
            "value-no-vendor-prefix": null,
            "custom-property-pattern": null,
            "no-descending-specificity": null
        }
    }
}
