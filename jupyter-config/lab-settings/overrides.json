{
  "@jupyterlab/apputils-extension:themes": {
    "theme": "Data4Now Light",
    "adaptive-theme": true,
    "preferred-light-theme": "Data4Now Light",
    "preferred-dark-theme": "Data4Now Dark",
    "theme-scrollbars": true
  },
  "@jupyterlab/codemirror-extension:plugin": {
    "defaultConfig": {
      "theme": "d4n-light",
      "lineNumbers": true,
      "lineWrap": false,
      "highlightActiveLine": true,
      "highlightTrailingWhitespace": false,
      "rulers": []
    }
  },
  "@jupyterlab/terminal-extension:plugin": {
    "theme": "inherit"
  },
  "@jupyterlab/notebook-extension:panel": {
    "toolbar": [
      { "name": "d4n-sep-run", "type": "spacer", "rank": 25 },
      { "name": "d4n-sep-celltype", "type": "spacer", "rank": 35 }
    ]
  }
}
