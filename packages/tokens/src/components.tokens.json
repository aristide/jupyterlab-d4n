      "$value": "52px",
      "$type": "dimension",
      "$description": "The brand mark inside the 96px plate. It is the same asset the top panel draws at 22px (PRD B5), so it is sized rather than redrawn. 52px leaves the plate reading as a plate: the glyph keeps a 22px margin on each side, which is the plate radius."
    },
    "accent": {
      "$value": "{color.action.default}",
      "$type": "color"
    },
    "dot": {
      "$value": "{color.danger.subtle}",
      "$type": "color",
      "$description": "The trailing stop of the loader bar gradient, which runs accent to this. It used to colour a separate magenta dot on the mark plate as well; the mark now carries its own wedge, so the loader is the only consumer."
    },
    "wordmark": {
      "$value": "{color.text.strong}",
      "$type": "color"
    },
    "muted": {
      "$value": "{color.chrome.railFg}",
      "$type": "color",
      "$description": "Tagline and status line. Measures 5.45:1 on splash.bg. The mockup's footer used a dimmer slate (#5A6B82) which measures 2.90:1 at 10px — an A1 failure on the first screen a user ever sees, so the footer takes this value too."
    },
