{
    "name": "@d4n/compat-shim",
    "version": "0.1.0",
    "private": true,
    "description": "Data4Now design system — per-extension compatibility CSS for third-party JupyterLab extensions",
    "license": "BSD-3-Clause",
    "author": {
        "name": "Data4Now",
        "email": "platform@data4now.org"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "style": "style/index.css",
    "styleModule": "style/index.js",
    "sideEffects": [
        "style/*.css",
        "style/**/*.css",
        "style/index.js"
    ],
    "files": [
        "lib/**/*.{d.ts,js,js.map}",
        "src/**/*.ts",
        "style/**/*.{css,js}",
        "docs/**/*.md"
    ],
    "scripts": {
        "build:lib": "tsc --sourceMap",
        "build:lib:prod": "tsc",
        "build:labextension": "jupyter labextension build .",
        "build:labextension:dev": "jupyter labextension build --development True .",
        "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
        "watch:labextension": "jupyter labextension watch ."
    },
    "dependencies": {
        "@jupyterlab/application": "^4.5.0"
    },
    "devDependencies": {
        "@jupyterlab/builder": "^4.5.0",
        "rimraf": "^5.0.1",
        "typescript": "~5.5.4"
    },
    "jupyterlab": {
        "extension": true,
        "outputDir": "../../jupyterlab_d4n/labextensions/@d4n/compat-shim",
        "discovery": {
            "server": {
                "managers": [
                    "pip"
                ],
                "base": {
                    "name": "jupyterlab_d4n"
                }
            }
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
