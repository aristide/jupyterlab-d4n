{
    "name": "@d4n/editor-theme",
    "version": "0.1.0",
    "private": true,
    "description": "Data4Now design system — CodeMirror 6 editor themes and debugger decorations",
    "license": "BSD-3-Clause",
    "author": {
        "name": "Data4Now",
        "email": "platform@data4now.org"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib/**/*.{d.ts,js,js.map}",
        "src/**/*.ts"
    ],
    "scripts": {
        "build:lib": "tsc --sourceMap",
        "build:lib:prod": "tsc",
        "build:labextension": "jupyter labextension build .",
        "build:labextension:dev": "jupyter labextension build --development True .",
        "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
        "watch:labextension": "jupyter labextension watch ."
    },
    "dependencies": {
        "@codemirror/language": "^6.12.1",
        "@codemirror/state": "^6.5.4",
        "@codemirror/view": "^6.39.14",
        "@d4n/tokens": "^0.1.0",
        "@jupyterlab/application": "^4.5.0",
        "@jupyterlab/codemirror": "^4.5.0",
        "@jupyterlab/debugger": "^4.5.0",
        "@jupyterlab/translation": "^4.5.0",
        "@lezer/highlight": "^1.2.0"
    },
    "devDependencies": {
        "@jupyterlab/builder": "^4.5.0",
        "rimraf": "^5.0.1",
        "typescript": "~5.5.4"
    },
    "jupyterlab": {
        "extension": true,
        "outputDir": "../../jupyterlab_d4n/labextensions/@d4n/editor-theme",
        "discovery": {
            "server": {
                "managers": [
                    "pip"
                ],
                "base": {
                    "name": "jupyterlab_d4n"
                }
            }
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
