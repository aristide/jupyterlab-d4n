# Copy to .env (gitignored) and adjust. Every value here has a working default,
# so `docker compose up -d` works with no .env at all.

# Directory bind-mounted read-only to /root/.ssh inside the jupyter container
# (it runs as root — see docker/README.md). Defaults to an empty, gitignored
# placeholder (no-op). Point it at your real SSH directory to use your own
# keys for git inside the container, e.g.:
#   HOST_SSH_DIR=${HOME}/.ssh          # macOS/Linux/Git Bash
#   HOST_SSH_DIR=C:/Users/you/.ssh     # Windows (PowerShell/cmd)
HOST_SSH_DIR=./docker/ssh-keys

# Pin the container to one theme instead of following the OS preference.
# Empty (default) = adaptive, per the shipped overrides.json (PRD §5.4).
# Useful for a deterministic Galata baseline or a screenshot run.
#   JUPYTERLAB_D4N_THEME=Data4Now Dark
JUPYTERLAB_D4N_THEME=

# Density variant (PRD §11 P5): 'comfortable' (default) or 'compact'.
JUPYTERLAB_D4N_DENSITY=comfortable

# Set to 0 to disable every D4N plugin and boot stock JupyterLab — the opt-out
# from PRD §15 Stage 4. The quickest way to check whether a bug is ours.
JUPYTERLAB_D4N=1
